# Safe template only. Copy to .env and provide your own credentials locally.
# Never commit .env.

# Main Telegram bot (required)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=30
CONTENT_FACTORY_BOT_USERNAME=ContentFactoryExampleBot

# Local durable state
VAULT_PATH=./runtime/vault
SHARED_CONTENT_PATH=./runtime/shared-content
RADAR_VAULT_PATH=./runtime/radar
RADAR_REDIRECT_TO_CONTENT_FACTORY=false

# Codex-backed LLM client
CODEX_CLI_PATH=codex
CODEX_CHAT_MODEL=gpt-5.6-sol
CODEX_TIMEOUT_SECONDS=180
CODEX_PRODUCTION_TIMEOUT_SECONDS=600
CODEX_WORKDIR=.
CODEX_IMAGE_TIMEOUT_SECONDS=600
IMAGE_PROVIDER=codex

# OpenAI-compatible image API (optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=low

# Voice transcription (optional)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ru

# Hosted video providers (optional; disabled without credentials)
POLZA_AI_API_KEY=
POLZA_BASE_URL=https://polza.ai/api
POLZA_POLL_INTERVAL_SECONDS=8
POLZA_TIMEOUT_SECONDS=900
POLZA_MAX_STATUS_RETRIES=3

KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
KIE_POLL_INTERVAL_SECONDS=8
KIE_TIMEOUT_SECONDS=900
KIE_MAX_STATUS_RETRIES=3

VIKTOR_API_KEY=
VIKTOR_BASE_URL=https://api.viktor.com
VIKTOR_POLL_INTERVAL_SECONDS=8
VIKTOR_TIMEOUT_SECONDS=1200
VIKTOR_MAX_STATUS_RETRIES=3

# LTX client integration (default-off)
LTX_VIDEO_ENABLED=false
LTX_API_TOKEN=
LTX_BASE_URL=https://ltx-worker.example.com
LTX_POLL_INTERVAL_SECONDS=8
LTX_TIMEOUT_SECONDS=1800
LTX_MAX_STATUS_RETRIES=3

# Research providers (optional)
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_INSTAGRAM_DATASET_ID=
BRIGHTDATA_POLL_INTERVAL_SECONDS=8
APIFY_API_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_MAX_TOTAL_CHARGE_USD=1.0
RESEARCH_DAYS=30
RESEARCH_RESULTS_LIMIT=50
RESEARCH_RESULTS_PER_ACCOUNT=5

# Isolated tester runtime (optional)
TELEGRAM_TESTER_USER_IDS=
TEST_VAULT_PATH=./runtime/test-vault
TEST_SHARED_CONTENT_PATH=./runtime/test-shared-content
PARTNER_ENV_FILE=.env.partner

# LTX worker service (required only when running the worker)
LTX_WORKER_ROOT=./runtime/ltx-worker
LTX_WORKER_HOST=127.0.0.1
LTX_WORKER_PORT=8080
LTX_INFERENCE_ENABLED=false
LTX_MAX_REQUEST_BYTES=26214400
LTX_INFERENCE_TIMEOUT_SECONDS=1800
LTX_COMFY_REQUEST_TIMEOUT_SECONDS=30
LTX_COMFY_POLL_SECONDS=2
LTX_COMFY_BASE_URL=http://127.0.0.1:8188
LTX_STUDIO_ROOT=./runtime/ltx-studio
LTX_COMFY_ROOT=./runtime/ltx-studio/runtime/ComfyUI
LTX_COMFY_INPUT_DIR=./runtime/ltx-studio/runtime/ComfyUI/input
LTX_COMFY_OUTPUT_DIR=./runtime/ltx-studio/runtime/ComfyUI/output
LTX_COMFY_MODEL_DIR=./runtime/ltx-studio/runtime/ComfyUI/models
LTX_API_WORKFLOW_PATH=./ltx_worker/assets/ltx23-i2v-api.json
LTX_RUNTIME_MANIFEST_PATH=./ltx_worker/assets/runtime-manifest.json
LTX_DEPENDENCY_LOCK_PATH=./ltx_worker/assets/comfyui-lightning-py312.lock
LTX_VERIFICATION_MARKER=./runtime/ltx-studio/runtime/verified.json
LTX_FFPROBE_PATH=ffprobe
LTX_EXECUTOR=local

# Remote GPU executor (optional; leave empty for local mode)
IMMERS_AUTH_URL=https://identity.example.com/v3
IMMERS_COMPUTE_URL=https://compute.example.com/v2.1
IMMERS_USERNAME=
IMMERS_PASSWORD=
IMMERS_PROJECT=
IMMERS_DOMAIN=Default
IMMERS_SERVER_ID=
IMMERS_SSH_HOST=gpu@203.0.113.10
IMMERS_SSH_KEY=/run/secrets/ltx_ssh_key
IMMERS_COMFY_ROOT=/srv/ltx/runtime/ComfyUI
IMMERS_VENV=/srv/ltx/venv
IMMERS_WATCHDOG_MINUTES=35
