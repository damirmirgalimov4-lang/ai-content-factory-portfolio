# Optional isolated collaborator bot. Copy to .env.partner.
# The first user pairs through a one-time local code; no public default access.
PARTNER_TELEGRAM_BOT_TOKEN=
PARTNER_TELEGRAM_ALLOWED_USER_IDS=
PARTNER_TELEGRAM_TESTER_USER_IDS=
PARTNER_TELEGRAM_POLL_TIMEOUT_SECONDS=30

PARTNER_VAULT_PATH=./runtime/partner-vault
PARTNER_TEST_VAULT_PATH=./runtime/partner-test-vault
PARTNER_SHARED_CONTENT_PATH=./runtime/shared-content
PARTNER_TEST_SHARED_CONTENT_PATH=./runtime/partner-test-shared-content
PARTNER_RADAR_REDIRECT_TO_CONTENT_FACTORY=false

PARTNER_CODEX_CLI_PATH=codex
PARTNER_CODEX_CHAT_MODEL=gpt-5.6-sol
PARTNER_CODEX_TIMEOUT_SECONDS=180
PARTNER_CODEX_PRODUCTION_TIMEOUT_SECONDS=600
PARTNER_CODEX_WORKDIR=./runtime/partner-vault
PARTNER_IMAGE_PROVIDER=codex
PARTNER_OPENAI_IMAGE_MODEL=gpt-image-2
PARTNER_OPENAI_IMAGE_SIZE=1024x1536
PARTNER_OPENAI_IMAGE_QUALITY=low
PARTNER_CODEX_IMAGE_TIMEOUT_SECONDS=600

PARTNER_YOUTUBE_API_KEY=
PARTNER_YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3
PARTNER_BRIGHTDATA_API_TOKEN=
PARTNER_BRIGHTDATA_BASE_URL=https://api.brightdata.com
PARTNER_BRIGHTDATA_INSTAGRAM_DATASET_ID=
PARTNER_BRIGHTDATA_POLL_INTERVAL_SECONDS=8
PARTNER_RESEARCH_DAYS=30
PARTNER_RESEARCH_RESULTS_LIMIT=50
PARTNER_RESEARCH_RESULTS_PER_ACCOUNT=5
PARTNER_DEEPGRAM_API_KEY=
PARTNER_DEEPGRAM_MODEL=nova-3
PARTNER_DEEPGRAM_LANGUAGE=ru
